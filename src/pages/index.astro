// Structured Data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.title,
  url: siteUrl,
  sameAs: [
    "https://www.linkedin.com/in/vinit-sarvade",
    "https://github.com/VinitSarvade",
  ],
  email: profile.email,
  description: profile.about,
  alumniOf: {
    "@type": "Organization",
    name: "Educational Institution",
  },
  knowsAbout: profile.skills,
};
---

<RootLayout>
  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="flex flex-col min-h-dvh justify-center items-center p-5 sm:p-10">
    <article class="max-w-3xl w-full space-y-8">
      <!-- Header Section -->
      <header class="text-center space-y-4">
        <h1 class="text-4xl sm:text-6xl font-semibold tracking-wide">
          {profile.name}
        </h1>
        <p class="text-xl sm:text-2xl">
          <span>{profile.title}</span>
          <span class="hidden sm:inline">&nbsp;&middot;&nbsp;</span>
          <span class="block sm:inline">{profile.experience}</span>
        </p>
        <p class="text-base sm:text-lg text-gray-600">
          {profile.headline}
        </p>
      </header>

      <!-- About Section -->
      <section class="space-y-3">
        <h2 class="text-2xl font-semibold">About</h2>
        <p class="text-lg leading-relaxed">{profile.about}</p>
      </section>

      <!-- Experience Section -->
      <section class="space-y-4">
        <h2 class="text-2xl font-semibold">Experience</h2>
        <div class="space-y-6">
          {
            experiences.map((exp) => (
              <article class="space-y-2">
                <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-1">
                  <div>
                    <h3 class="text-lg font-semibold">{exp.position}</h3>
                    <p class="text-base text-gray-700">{exp.company} · {exp.location}</p>
                  </div>
                  <p class="text-sm text-gray-600 sm:text-right">{exp.date}</p>
                </div>
                <ul class="list-disc list-inside space-y-1 text-sm text-gray-700">
                  {exp.highlights.map((highlight) => (
                    <li class="leading-relaxed">{highlight}</li>
                  ))}
                </ul>
                <p class="text-xs text-gray-600 italic">
                  <strong>Technologies:</strong> {exp.technologies}
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Skills Section -->
      <section class="space-y-3">
        <h2 class="text-2xl font-semibold">Skills</h2>
        <ul class="flex flex-wrap gap-2" role="list">
          {
            profile.skills.map((skill) => (
              <li class="px-4 py-2 bg-gray-200 rounded-lg text-base">
                {skill}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Projects Section -->
      <section class="space-y-3">
        <h2 class="text-2xl font-semibold">Projects</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            projects.map((project) => (
              <article class="p-4 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
                <a
                  href={project.url}
                  target="_blank"
                  rel="noreferrer noopener"
                  class="block"
                >
                  <h3 class="text-lg font-semibold mb-2">{project.name}</h3>
                  <p class="text-sm mb-2">{project.description}</p>
                  <p class="text-xs text-gray-600">{project.tech}</p>
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Contact Section -->
      <section class="space-y-3">
        <h2 class="text-2xl font-semibold">Contact</h2>
        <p class="text-lg">
          <a
            href={`mailto:${profile.email}`}
            class="hover:underline"
            rel="noreferrer"
          >
            {profile.email}
          </a>
        </p>
      </section>

      <!-- Social Links -->
      <nav aria-label="Social media links" class="flex flex-row justify-center items-center gap-10 pt-4">
        {
          LINKS.map((link) => (
            <a href={link.url} target="_blank" rel="noreferrer noopener" title={link.name} aria-label={link.name}>
              <Image
                src={link.icon}
                alt={`${link.name} icon`}
                width="24"
                height="24"
                densities={[1, 2, 3]}
              />
            </a>
          ))
        }
      </nav>
    </article>
  </main>
</RootLayout>
