---
import { Image } from "astro:assets";
import RootLayout from "../layouts/index.astro";

const siteUrl = "https://vinit.dev";

const LINKS = [
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/vinit-sarvade",
    icon: import("../assets/LinkedIn.svg"),
  },
  {
    name: "GitHub",
    url: "https://github.com/VinitSarvade",
    icon: import("../assets/Github.svg"),
  },
  {
    name: "Email",
    url: "mailto:vinit.sarvade.08@gmail.com",
    icon: import("../assets/Email.svg"),
  },
  {
    name: "Resume",
    url: "https://rxresu.me/vinit-sarvade/vinit-s-resume",
    icon: import("../assets/Resume.svg"),
  },
];

const profile = {
  name: "Vinit Sarvade",
  title: "Full Stack Engineer",
  experience: "7+ years of experience",
  email: "vinit.sarvade.08@gmail.com",
  location: "Software Engineer",
  about:
    "Experienced Full Stack Engineer with a passion for building scalable web applications and solving complex technical challenges. Skilled in modern web technologies and frameworks.",
  skills: [
    "Full Stack Development",
    "Web Applications",
    "Software Engineering",
    "Modern Web Technologies",
    "Scalable Systems",
  ],
};

const projects = [
  {
    name: "Invoice Generator",
    description: "TypeScript-based invoice generation application",
    url: "https://github.com/VinitSarvade/invoice-generator",
    tech: "TypeScript",
  },
  {
    name: "Multitrack Audio Player",
    description: "Audio application for playing multiple tracks",
    url: "https://github.com/VinitSarvade/multitrack-audio-player",
    tech: "TypeScript",
  },
  {
    name: "E-Store",
    description: "E-commerce platform built with modern web technologies",
    url: "https://github.com/VinitSarvade/estore",
    tech: "React, TypeScript, Next.js",
  },
  {
    name: "Xero Balance Sheet",
    description: "Financial tool for balance sheet management",
    url: "https://github.com/VinitSarvade/xero-balance-sheet",
    tech: "TypeScript",
  },
  {
    name: "Wildlife Explorer",
    description: "Application for exploring wildlife information",
    url: "https://github.com/VinitSarvade/wildlife-explorer",
    tech: "TypeScript",
  },
  {
    name: "Files Explorer",
    description: "File management and exploration application",
    url: "https://github.com/VinitSarvade/files-explorer",
    tech: "TypeScript",
  },
  {
    name: "CloneBnB",
    description: "Airbnb-inspired accommodation booking platform",
    url: "https://github.com/VinitSarvade/clonebnb",
    tech: "TypeScript",
  },
  {
    name: "Expensify Clone",
    description: "Expense tracking application",
    url: "https://github.com/VinitSarvade/expensify-clone",
    tech: "TypeScript",
  },
  {
    name: "HN Clone React",
    description: "Hacker News clone built with React and SSR",
    url: "https://github.com/VinitSarvade/hn-clone-react",
    tech: "React, JavaScript",
  },
  {
    name: "Neo Calendar",
    description: "Modern calendar component",
    url: "https://github.com/VinitSarvade/neo-calendar",
    tech: "TypeScript",
  },
];

// Structured Data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.title,
  url: siteUrl,
  sameAs: [
    "https://www.linkedin.com/in/vinit-sarvade",
    "https://github.com/VinitSarvade",
  ],
  email: profile.email,
  description: profile.about,
  alumniOf: {
    "@type": "Organization",
    name: "Educational Institution",
  },
  knowsAbout: profile.skills,
};
---

<RootLayout>
  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="flex flex-col min-h-dvh justify-center items-center p-5 sm:p-10">
    <article class="max-w-3xl w-full space-y-8">
      <!-- Header Section -->
      <header class="text-center space-y-4">
        <h1 class="text-4xl sm:text-6xl font-semibold tracking-wide">
          {profile.name}
        </h1>
        <p class="text-xl sm:text-2xl">
          <span>{profile.title}</span>
          <span class="hidden sm:inline">&nbsp;&middot;&nbsp;</span>
          <span class="block sm:inline">{profile.experience}</span>
        </p>
      </header>

      <!-- About Section -->
      <section class="space-y-3">
        <h2 class="text-2xl font-semibold">About</h2>
        <p class="text-lg leading-relaxed">{profile.about}</p>
      </section>

      <!-- Skills Section -->
      <section class="space-y-3">
        <h2 class="text-2xl font-semibold">Skills</h2>
        <ul class="flex flex-wrap gap-2" role="list">
          {
            profile.skills.map((skill) => (
              <li class="px-4 py-2 bg-gray-200 rounded-lg text-base">
                {skill}
              </li>
            ))
          }
        </ul>
      </section>

      <!-- Projects Section -->
      <section class="space-y-3">
        <h2 class="text-2xl font-semibold">Projects</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {
            projects.map((project) => (
              <article class="p-4 bg-gray-100 rounded-lg hover:bg-gray-200 transition-colors">
                <a
                  href={project.url}
                  target="_blank"
                  rel="noreferrer noopener"
                  class="block"
                >
                  <h3 class="text-lg font-semibold mb-2">{project.name}</h3>
                  <p class="text-sm mb-2">{project.description}</p>
                  <p class="text-xs text-gray-600">{project.tech}</p>
                </a>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Contact Section -->
      <section class="space-y-3">
        <h2 class="text-2xl font-semibold">Contact</h2>
        <p class="text-lg">
          <a
            href={`mailto:${profile.email}`}
            class="hover:underline"
            rel="noreferrer"
          >
            {profile.email}
          </a>
        </p>
      </section>

      <!-- Social Links -->
      <nav aria-label="Social media links" class="flex flex-row justify-center items-center gap-10 pt-4">
        {
          LINKS.map((link) => (
            <a href={link.url} target="_blank" rel="noreferrer noopener" title={link.name} aria-label={link.name}>
              <Image
                src={link.icon}
                alt={`${link.name} icon`}
                width="24"
                height="24"
                densities={[1, 2, 3]}
              />
            </a>
          ))
        }
      </nav>
    </article>
  </main>
</RootLayout>
