---

<RootLayout>
  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="flex flex-col min-h-dvh justify-center items-center p-5 sm:p-10">
    <article class="max-w-3xl w-full space-y-8">
      <!-- Dark Mode Toggle Button -->
      <button
        id="theme-toggle"
        class="fixed top-4 right-4 p-2 rounded-lg bg-white dark:bg-slate-900 border border-gray-200 dark:border-slate-700 hover:bg-gray-100 dark:hover:bg-slate-800 transition-all shadow-sm hover:shadow-md"
        aria-label="Toggle dark mode"
      >
        <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
        <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
        </svg>
      </button>
      <!-- Header Section -->
      <header class="text-center space-y-5">
        {/* Social Links at Top */}
        <nav aria-label="Social media links" class="flex flex-row justify-center items-center gap-6">
          {
            LINKS.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noreferrer noopener"
                title={link.name}
                aria-label={link.name}
                class="p-2 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-800 transition-colors"
              >
                <Image
                  src={link.icon}
                  alt={`${link.name} icon`}
                  width="24"
                  height="24"
                  densities={[1, 2, 3]}
                />
              </a>
            ))
          }
        </nav>

        <h1 class="text-4xl sm:text-6xl font-bold tracking-tight">
          {profile.name}
        </h1>
        <p class="text-xl sm:text-2xl font-medium text-gray-700 dark:text-gray-300">
          <span>{profile.title}</span>
          <span class="hidden sm:inline">&nbsp;&middot;&nbsp;</span>
          <span class="block sm:inline">{profile.experience}</span>
        </p>
        <p class="text-base sm:text-lg text-gray-600 dark:text-gray-400 font-normal">
          {profile.headline}
        </p>
      </header>

      <!-- About Section -->
