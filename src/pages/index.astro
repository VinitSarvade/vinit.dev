// Structured Data for SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.title,
  url: siteUrl,
  sameAs: [
    "https://www.linkedin.com/in/vinit-sarvade",
    "https://github.com/VinitSarvade",
  ],
  email: profile.email,
  description: profile.about,
  alumniOf: {
    "@type": "Organization",
    name: "Educational Institution",
  },
  knowsAbout: Object.values(profile.skills).flat().map(s => s.name),
};
---

<RootLayout>
  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <main class="flex flex-col min-h-dvh justify-center items-center p-5 sm:p-10">
    <article class="max-w-3xl w-full space-y-8">
      <!-- Dark Mode Toggle Button -->
      <button
        id="theme-toggle"
        class="fixed top-4 right-4 p-2 rounded-lg bg-gray-200 dark:bg-gray-800 hover:bg-gray-300 dark:hover:bg-gray-700 transition-colors"
        aria-label="Toggle dark mode"
      >
        <svg id="theme-toggle-dark-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <path d="M17.293 13.293A8 8 0 016.707 2.707a8.001 8.001 0 1010.586 10.586z"></path>
        </svg>
        <svg id="theme-toggle-light-icon" class="hidden w-5 h-5" fill="currentColor" viewBox="0 0 20 20" xmlns="http://www.w3.org/2000/svg">
          <path d="M10 2a1 1 0 011 1v1a1 1 0 11-2 0V3a1 1 0 011-1zm4 8a4 4 0 11-8 0 4 4 0 018 0zm-.464 4.95l.707.707a1 1 0 001.414-1.414l-.707-.707a1 1 0 00-1.414 1.414zm2.12-10.607a1 1 0 010 1.414l-.706.707a1 1 0 11-1.414-1.414l.707-.707a1 1 0 011.414 0zM17 11a1 1 0 100-2h-1a1 1 0 100 2h1zm-7 4a1 1 0 011 1v1a1 1 0 11-2 0v-1a1 1 0 011-1zM5.05 6.464A1 1 0 106.465 5.05l-.708-.707a1 1 0 00-1.414 1.414l.707.707zm1.414 8.486l-.707.707a1 1 0 01-1.414-1.414l.707-.707a1 1 0 011.414 1.414zM4 11a1 1 0 100-2H3a1 1 0 000 2h1z" fill-rule="evenodd" clip-rule="evenodd"></path>
        </svg>
      </button>
      <!-- Header Section -->
      <header class="text-center space-y-5">
        {/* Social Links at Top */}
        <nav aria-label="Social media links" class="flex flex-row justify-center items-center gap-6">
          {
            LINKS.map((link) => (
              <a
                href={link.url}
                target="_blank"
                rel="noreferrer noopener"
                title={link.name}
                aria-label={link.name}
                class="p-2 rounded-lg hover:bg-gray-200 dark:hover:bg-gray-800 transition-colors"
              >
                <Image
                  src={link.icon}
                  alt={`${link.name} icon`}
                  width="24"
                  height="24"
                  densities={[1, 2, 3]}
                />
              </a>
            ))
          }
        </nav>

        <h1 class="text-4xl sm:text-6xl font-bold tracking-tight">
          {profile.name}
        </h1>
        <p class="text-xl sm:text-2xl font-medium text-gray-700 dark:text-gray-300">
          <span>{profile.title}</span>
          <span class="hidden sm:inline">&nbsp;&middot;&nbsp;</span>
          <span class="block sm:inline">{profile.experience}</span>
        </p>
        <p class="text-base sm:text-lg text-gray-600 dark:text-gray-400 font-normal">
          {profile.headline}
        </p>
      </header>

      <!-- About Section -->
      <section class="space-y-3">
        <h2 class="text-2xl font-semibold">About</h2>
        <p class="text-base leading-relaxed font-normal text-gray-700 dark:text-gray-300">{profile.about}</p>
      </section>

      <!-- Experience Section -->
      <section class="space-y-5">
        <h2 class="text-2xl font-semibold">Experience</h2>
        <div class="space-y-4">
          {
            experiences.map((exp, index) => (
              <article class="relative pl-8 pb-8 border-l-2 border-gray-300 dark:border-gray-700 last:pb-0">
                {/* Timeline dot */}
                <div class="absolute left-[-9px] top-0 w-4 h-4 rounded-full bg-gray-800 dark:bg-gray-200 border-2 border-gray-100 dark:border-gray-900"></div>

                <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5 shadow-sm hover:shadow-md transition-shadow">
                  <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2 mb-3">
                    <div>
                      <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100">{exp.position}</h3>
                      <p class="text-base font-medium text-gray-700 dark:text-gray-300">{exp.company}</p>
                      <p class="text-sm text-gray-500 dark:text-gray-400">{exp.location}</p>
                    </div>
                    <span class="inline-flex items-center px-3 py-1 text-sm font-medium text-gray-700 dark:text-gray-300 bg-gray-100 dark:bg-gray-700 rounded-full whitespace-nowrap">
                      {exp.date}
                    </span>
                  </div>

                  <ul class="space-y-2 mb-4">
                    {exp.highlights.map((highlight) => (
                      <li class="flex items-start text-sm font-normal text-gray-700 dark:text-gray-300">
                        <span class="text-gray-400 mr-2 mt-1">▹</span>
                        <span class="leading-relaxed">{highlight}</span>
                      </li>
                    ))}
                  </ul>

                  <div class="pt-3 border-t border-gray-200 dark:border-gray-700">
                    <p class="text-xs font-normal text-gray-600 dark:text-gray-400">
                      <span class="font-medium">Technologies:</span> {exp.technologies}
                    </p>
                  </div>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      <!-- Skills Section -->
      <section class="space-y-5">
        <h2 class="text-2xl font-semibold">Skills</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          {
            Object.entries(profile.skills).map(([category, skillList]) => (
              <div class="bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5 shadow-sm">
                <h3 class="text-lg font-bold text-gray-900 dark:text-gray-100 mb-3 pb-2 border-b border-gray-200 dark:border-gray-700">
                  {category}
                </h3>
                <div class="flex flex-wrap gap-3">
                  {skillList.map((skill) => (
                    <span class="inline-flex items-center gap-2 px-3 py-2 text-sm font-medium text-gray-700 dark:text-gray-200 bg-gray-100 dark:bg-gray-700 rounded-md hover:bg-gray-200 dark:hover:bg-gray-600 transition-colors">
                      <img
                        src={`https://cdn.simpleicons.org/${skill.icon}`}
                        alt={`${skill.name} logo`}
                        class="w-4 h-4 dark:hidden"
                      />
                      <img
                        src={`https://cdn.simpleicons.org/${skill.icon}/ffffff`}
                        alt={`${skill.name} logo`}
                        class="w-4 h-4 hidden dark:inline"
                      />
                      {skill.name}
                    </span>
                  ))}
                </div>
              </div>
            ))
          }
        </div>
      </section>

      <!-- Projects Section -->
      <section class="space-y-5">
        <h2 class="text-2xl font-semibold">Projects</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5">
          {
            projects.map((project) => (
              <a
                href={project.url}
                target="_blank"
                rel="noreferrer noopener"
                class="group block"
              >
                <article class="h-full bg-white dark:bg-gray-800 border border-gray-200 dark:border-gray-700 rounded-lg p-5 shadow-sm hover:shadow-lg hover:border-gray-300 dark:hover:border-gray-600 transition-all duration-200">
                  <div class="flex items-start justify-between mb-3">
                    <div class="p-2 bg-gray-100 dark:bg-gray-700 rounded-lg">
                      <svg class="w-5 h-5 text-gray-600 dark:text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
                      </svg>
                    </div>
                    <svg class="w-4 h-4 text-gray-400 group-hover:text-gray-600 dark:group-hover:text-gray-300 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path>
                    </svg>
                  </div>

                  <h3 class="text-lg font-semibold text-gray-900 dark:text-gray-100 mb-2 group-hover:text-gray-700 dark:group-hover:text-gray-200 transition-colors">
                    {project.name}
                  </h3>

                  <p class="text-sm font-normal text-gray-600 dark:text-gray-400 mb-4 line-clamp-2">
                    {project.description}
                  </p>

                  <div class="pt-3 border-t border-gray-200 dark:border-gray-700">
                    <p class="text-xs font-normal text-gray-500 dark:text-gray-400">
                      {project.tech}
                    </p>
                  </div>
                </article>
              </a>
            ))
          }
        </div>
      </section>

      <!-- Contact Section -->
      <section class="space-y-3">
        <h2 class="text-2xl font-semibold">Contact</h2>
        <p class="text-lg font-normal">
          <a
            href={`mailto:${profile.email}`}
            class="hover:underline text-gray-700 dark:text-gray-300"
            rel="noreferrer"
          >
            {profile.email}
          </a>
        </p>
      </section>
    </article>
  </main>

  <!-- Dark Mode Toggle Script -->
  <script>
    const themeToggleBtn = document.getElementById('theme-toggle');
    const themeToggleDarkIcon = document.getElementById('theme-toggle-dark-icon');
    const themeToggleLightIcon = document.getElementById('theme-toggle-light-icon');

    // Show the correct icon based on current theme
    if (document.documentElement.classList.contains('dark')) {
      themeToggleLightIcon?.classList.remove('hidden');
    } else {
      themeToggleDarkIcon?.classList.remove('hidden');
    }

    themeToggleBtn?.addEventListener('click', function() {
      // Toggle icons
      themeToggleDarkIcon?.classList.toggle('hidden');
      themeToggleLightIcon?.classList.toggle('hidden');

      // Toggle dark mode
      if (document.documentElement.classList.contains('dark')) {
        document.documentElement.classList.remove('dark');
        localStorage.setItem('theme', 'light');
      } else {
        document.documentElement.classList.add('dark');
        localStorage.setItem('theme', 'dark');
      }
    });
  </script>
</RootLayout>
