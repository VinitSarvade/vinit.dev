---
import '../styles/global.css';
import { MyPortfolio } from '../components/my-portfolio';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="author" content="Vinit Sarvade" />
    <meta name="description" content="Vinit Sarvade's Portfolio" />
    <meta name="keywords" content="Vinit Sarvade, Portfolio" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/favicon/apple-touch-icon.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="32x32"
      href="/favicon/favicon-32x32.png"
    />
    <link
      rel="icon"
      type="image/png"
      sizes="16x16"
      href="/favicon/favicon-16x16.png"
    />
    <link rel="manifest" href="/favicon/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://vinit.dev" />
    <meta property="og:title" content="Vinit Sarvade — Fullstack Engineer" />
    <meta property="og:description" content="Full-stack engineer with 9+ years of experience in React, Next.js, Node.js, and Golang. Building scalable web and mobile apps across SaaS, e-commerce, and climate tech." />
    <meta property="og:image" content="https://vinit.dev/favicon/android-chrome-512x512.png" />

    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Vinit Sarvade — Fullstack Engineer" />
    <meta name="twitter:description" content="Full-stack engineer with 9+ years of experience in React, Next.js, Node.js, and Golang. Building scalable web and mobile apps across SaaS, e-commerce, and climate tech." />
    <meta name="twitter:image" content="https://vinit.dev/favicon/android-chrome-512x512.png" />

		<title>Vinit Sarvade</title>
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "Person",
			"name": "Vinit Sarvade",
			"url": "https://vinit.dev",
			"jobTitle": "Fullstack Engineer",
			"sameAs": [
				"https://github.com/VinitSarvade",
				"https://www.linkedin.com/in/vinit-sarvade/"
			],
			"knowsAbout": [
				"React", "Next.js", "TypeScript", "Node.js", "Golang",
				"React Native", "Expo", "TailwindCSS", "Angular", "Vue",
				"GraphQL", "PostgreSQL", "MongoDB", "Redis", "Docker", "Kubernetes", "AWS",
				"AI Agents", "LangChain", "Microservices", "REST APIs", "CI/CD",
				"SEO", "Web Performance", "System Design"
			],
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Bangalore",
				"addressCountry": "IN"
			}
		})} />
		<script is:inline>
			const t = localStorage.getItem('theme');
			if (t === 'dark' || (!t && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
				document.documentElement.classList.add('dark');
			}
		</script>
	</head>

	<body>
		<main class="min-h-screen flex flex-col p-4">
			<MyPortfolio />
		</main>
		<script>
			// Dark mode
			const sun = document.getElementById('theme-icon-sun');
			const moon = document.getElementById('theme-icon-moon');
			function applyTheme(dark: boolean) {
				document.documentElement.classList.toggle('dark', dark);
				sun?.classList.toggle('hidden', !dark);
				moon?.classList.toggle('hidden', dark);
			}
			const stored = localStorage.getItem('theme');
			applyTheme(stored ? stored === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches);
			document.getElementById('theme-toggle')?.addEventListener('click', () => {
				const isDark = !document.documentElement.classList.contains('dark');
				localStorage.setItem('theme', isDark ? 'dark' : 'light');
				applyTheme(isDark);
			});

			// Experience toggle
			const toggle = document.getElementById('experience-toggle');
			const el = document.getElementById('experience-collapsible');
			const gradient = document.getElementById('experience-gradient');
			const text = document.getElementById('experience-toggle-text');
			const icon = document.getElementById('experience-toggle-icon');
			let expanded = false;

			toggle?.addEventListener('click', () => {
				if (!el) return;
				expanded = !expanded;
				if (expanded) {
					el.style.maxHeight = el.scrollHeight + 'px';
					gradient?.classList.add('opacity-0');
					icon?.classList.add('rotate-180');
					if (text) text.textContent = 'Show less';
				} else {
					el.style.maxHeight = '';
					gradient?.classList.remove('opacity-0');
					icon?.classList.remove('rotate-180');
					if (text) text.textContent = 'Show more';
				}
			});
		</script>
	</body>
</html>
