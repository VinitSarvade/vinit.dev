---
import { Image } from "astro:assets";
import RootLayout from "../layouts/index.astro";

const LINKS = [
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/vinit-sarvade",
    icon: import("../assets/LinkedIn.svg"),
  },
  {
    name: "GitHub",
    url: "https://github.com/VinitSarvade",
    icon: import("../assets/Github.svg"),
  },
  {
    name: "Email",
    url: "mailto:vinit.sarvade.08@gmail.com",
    icon: import("../assets/Email.svg"),
  },
  {
    name: "Resume",
    url: "https://rxresu.me/vinit-sarvade/vinit-s-resume",
    icon: import("../assets/Resume.svg"),
  },
];

const profile = {
  name: "Vinit Sarvade",
  title: "Full Stack Engineer",
  experience: "7+ years of experience",
  email: "vinit.sarvade.08@gmail.com",
  location: "Software Engineer",
  about:
    "Experienced Full Stack Engineer with a passion for building scalable web applications and solving complex technical challenges. Skilled in modern web technologies and frameworks.",
  skills: [
    "Full Stack Development",
    "Web Applications",
    "Software Engineering",
    "Modern Web Technologies",
    "Scalable Systems",
  ],
};
---

<RootLayout>
  <main class="flex flex-col min-h-dvh justify-center items-center p-5 sm:p-10">
    <div class="max-w-3xl w-full space-y-8">
      <!-- Header Section -->
      <div class="text-center space-y-4">
        <h1 class="text-4xl sm:text-6xl font-semibold tracking-wide">
          {profile.name}
        </h1>
        <div class="flex flex-col sm:flex-row justify-center items-center">
          <h2 class="text-xl sm:text-2xl">{profile.title}</h2>
          <h2 class="text-xl sm:text-2xl hidden sm:block"
            >&nbsp;&middot;&nbsp;</h2
          >
          <h2 class="text-xl sm:text-2xl">{profile.experience}</h2>
        </div>
      </div>

      <!-- About Section -->
      <div class="space-y-3">
        <h3 class="text-2xl font-semibold">About</h3>
        <p class="text-lg leading-relaxed">{profile.about}</p>
      </div>

      <!-- Skills Section -->
      <div class="space-y-3">
        <h3 class="text-2xl font-semibold">Skills</h3>
        <div class="flex flex-wrap gap-2">
          {
            profile.skills.map((skill) => (
              <span class="px-4 py-2 bg-gray-200 rounded-lg text-base">
                {skill}
              </span>
            ))
          }
        </div>
      </div>

      <!-- Contact Section -->
      <div class="space-y-3">
        <h3 class="text-2xl font-semibold">Contact</h3>
        <p class="text-lg">
          <a
            href={`mailto:${profile.email}`}
            class="hover:underline"
            rel="noreferrer"
          >
            {profile.email}
          </a>
        </p>
      </div>

      <!-- Social Links -->
      <div class="flex flex-row justify-center items-center gap-10 pt-4">
        {
          LINKS.map((link) => (
            <a href={link.url} target="_blank" rel="noreferrer" title={link.name}>
              <Image
                src={link.icon}
                alt={link.name}
                width="24"
                height="24"
                densities={[1, 2, 3]}
              />
            </a>
          ))
        }
      </div>
    </div>
  </main>
</RootLayout>
