---
interface Education {
  institution: string;
  degree: string;
  field: string;
  location: string;
  date: string;
  grade?: string;
}

interface Props {
  education: Education[];
}

const { education } = Astro.props;
---

<section class="space-y-5 animate-section">
  <h2
    class="text-2xl font-semibold bg-gradient-to-r from-cyan-600 to-blue-600 dark:from-cyan-400 dark:to-blue-400 bg-clip-text text-transparent"
  >
    Education
  </h2>
  <div class="space-y-4">
    {
      education.map((edu) => (
        <article class="timeline-item relative pl-8 pb-8 border-l-2 border-cyan-500 dark:border-cyan-400 last:pb-0">
          {/* Timeline Dot */}
          <div class="timeline-dot absolute left-[-9px] top-0 w-4 h-4 rounded-full bg-gradient-to-r from-cyan-500 to-blue-500 dark:from-cyan-400 dark:to-blue-400 border-2 border-gray-50 dark:border-slate-950 shadow-lg" />

          {/* Education Card */}
          <div class="bg-white dark:bg-slate-900 border-2 border-gray-200 dark:border-slate-800 rounded-lg p-5 shadow-sm hover:shadow-xl hover:border-cyan-300 dark:hover:border-cyan-700 transition-all duration-300">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2 mb-3">
              <div>
                <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100">
                  {edu.institution}
                </h3>
                <p class="text-base font-semibold text-cyan-600 dark:text-cyan-400 mt-1">
                  {edu.degree}
                </p>
                {edu.field && (
                  <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                    {edu.field}
                  </p>
                )}
              </div>
              <div class="text-left sm:text-right flex-shrink-0">
                <p class="text-sm font-medium text-gray-600 dark:text-gray-400">
                  {edu.date}
                </p>
                <p class="text-sm text-gray-500 dark:text-gray-500 mt-1">
                  {edu.location}
                </p>
              </div>
            </div>
            {edu.grade && (
              <div class="mt-3 pt-3 border-t border-gray-200 dark:border-slate-700">
                <p class="text-sm text-gray-700 dark:text-gray-300">
                  <span class="font-semibold">Grade:</span> {edu.grade}
                </p>
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
