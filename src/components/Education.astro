---
interface Education {
  institution: string;
  degree: string;
  field: string;
  location: string;
  date: string;
  grade?: string;
}

interface Props {
  education: Education[];
}

const { education } = Astro.props;
---

<section class="space-y-5 animate-section">
  <h2
    class="text-3xl font-bold bg-gradient-to-r from-primary-600 to-secondary-600 dark:from-primary-400 dark:to-secondary-400 bg-clip-text text-transparent"
  >
    Education
  </h2>
  <div class="space-y-4">
    {
      education.map((edu) => (
        <article class="timeline-item relative pl-8 pb-8 border-l-2 border-primary-300 dark:border-primary-700 last:pb-0">
          {/* Timeline Dot */}
          <div class="timeline-dot absolute left-[-9px] top-0 w-4 h-4 rounded-full bg-gradient-to-r from-primary-500 to-secondary-500 dark:from-primary-400 dark:to-secondary-400 border-2 border-slate-50 dark:border-slate-900 shadow-lg" />

          {/* Education Card */}
          <div class="bg-white dark:bg-slate-800/50 backdrop-blur-sm border-2 border-primary-100 dark:border-primary-900/30 rounded-2xl p-6 shadow-md hover:shadow-xl hover:border-primary-300 dark:hover:border-primary-600 hover:scale-[1.02] transition-all duration-300">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2 mb-3">
              <div>
                <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100">
                  {edu.institution}
                </h3>
                <p class="text-base font-semibold text-primary-600 dark:text-primary-400 mt-1">
                  {edu.degree}
                </p>
                {edu.field && (
                  <p class="text-sm text-gray-700 dark:text-gray-300 mt-1">
                    {edu.field}
                  </p>
                )}
              </div>
              <div class="text-left sm:text-right flex-shrink-0">
                <p class="text-sm font-semibold text-primary-700 dark:text-primary-300 bg-primary-100 dark:bg-primary-900/30 px-4 py-1.5 rounded-full shadow-sm">
                  {edu.date}
                </p>
                <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">
                  {edu.location}
                </p>
              </div>
            </div>
            {edu.grade && (
              <div class="mt-3 pt-3 border-t border-primary-200 dark:border-primary-800/30">
                <p class="text-sm text-gray-800 dark:text-gray-200">
                  <span class="font-semibold text-primary-600 dark:text-primary-400">Grade:</span> {edu.grade}
                </p>
              </div>
            )}
          </div>
        </article>
      ))
    }
  </div>
</section>
