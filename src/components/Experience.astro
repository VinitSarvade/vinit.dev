---
interface Experience {
  company: string;
  position: string;
  location: string;
  date: string;
  highlights: string[];
  technologies: string;
}

interface Props {
  experiences: Experience[];
}

const { experiences } = Astro.props;
const showViewMore = experiences.length > 3;
---

<section class="space-y-5 animate-section">
  <h2
    class="text-3xl font-bold bg-gradient-to-r from-purple-600 to-fuchsia-600 dark:from-purple-400 dark:to-fuchsia-400 bg-clip-text text-transparent"
  >
    Experience
  </h2>
  <div id="experience-list" class="space-y-4">
    {
      experiences.map((exp, index) => (
        <article
          class={`timeline-item relative pl-8 pb-8 border-l-2 border-purple-300 dark:border-purple-700 last:pb-0 ${index >= 3 ? "experience-hidden" : ""}`}
          style={`animation-delay: ${index * 0.1}s`}
        >
          {/* Timeline dot */}
          <div class="timeline-dot absolute left-[-9px] top-0 w-4 h-4 rounded-full bg-gradient-to-r from-purple-500 to-fuchsia-500 dark:from-purple-400 dark:to-fuchsia-400 border-2 border-amber-50 dark:border-indigo-950 shadow-lg" />

          <div class="bg-white dark:bg-indigo-900/50 backdrop-blur-sm border-2 border-purple-100 dark:border-purple-900/50 rounded-2xl p-6 shadow-md hover:shadow-xl hover:border-purple-300 dark:hover:border-purple-700 hover:scale-[1.02] transition-all duration-300">
            <div class="flex flex-col sm:flex-row sm:justify-between sm:items-start gap-2 mb-3">
              <div>
                <h3 class="text-xl font-bold text-gray-900 dark:text-gray-100">
                  {exp.position}
                </h3>
                <p class="text-base font-medium text-gray-700 dark:text-gray-300">
                  {exp.company}
                </p>
                <p class="text-sm text-gray-500 dark:text-gray-400">
                  {exp.location}
                </p>
              </div>
              <span class="inline-flex items-center px-4 py-1.5 text-sm font-semibold text-purple-700 dark:text-purple-300 bg-purple-100 dark:bg-purple-900/50 rounded-full whitespace-nowrap shadow-sm">
                {exp.date}
              </span>
            </div>

            <ul class="space-y-2 mb-4">
              {exp.highlights.map((highlight) => (
                <li class="flex items-start text-sm font-normal text-gray-800 dark:text-gray-200">
                  <span class="text-purple-500 dark:text-purple-400 mr-2 mt-1 font-bold">▹</span>
                  <span class="leading-relaxed">{highlight}</span>
                </li>
              ))}
            </ul>

            <div class="pt-3 border-t border-purple-200 dark:border-purple-800/50">
              <p class="text-xs font-normal text-gray-700 dark:text-gray-300">
                <span class="font-semibold text-purple-600 dark:text-purple-400">Technologies:</span>{" "}
                {exp.technologies}
              </p>
            </div>
          </div>
        </article>
      ))
    }
  </div>

  {
    showViewMore && (
      <div class="flex justify-center pt-3">
        <button
          id="view-more-btn"
          class="px-8 py-3 text-sm font-semibold text-white bg-gradient-to-r from-purple-600 to-fuchsia-600 hover:from-purple-700 hover:to-fuchsia-700 rounded-full shadow-lg hover:shadow-xl hover:scale-105 transition-all duration-300"
        >
          View More
        </button>
      </div>
    )
  }
</section>

<style>
  .experience-hidden {
    opacity: 0;
    max-height: 0;
    overflow: hidden;
    transform: translateY(-20px);
    transition:
      opacity 0.5s ease-out,
      max-height 0.5s ease-out,
      transform 0.5s ease-out,
      margin 0.5s ease-out,
      padding 0.5s ease-out;
    margin: 0;
    padding: 0;
  }

  .experience-revealing {
    opacity: 1;
    max-height: 2000px;
    transform: translateY(0);
    transition:
      opacity 0.6s ease-out,
      max-height 0.8s ease-out,
      transform 0.6s ease-out,
      margin 0.6s ease-out,
      padding 0.6s ease-out;
  }

  .experience-collapsing {
    opacity: 0;
    max-height: 0;
    transform: translateY(-20px);
    transition:
      opacity 0.4s ease-in,
      max-height 0.5s ease-in,
      transform 0.4s ease-in,
      margin 0.4s ease-in,
      padding 0.4s ease-in;
    margin: 0;
    padding: 0;
  }
</style>

<script>
  const viewMoreBtn = document.getElementById("view-more-btn");
  const hiddenExperiences = document.querySelectorAll(".experience-hidden");
  let isExpanded = false;

  viewMoreBtn?.addEventListener("click", () => {
    isExpanded = !isExpanded;

    hiddenExperiences.forEach((exp, index) => {
      if (isExpanded) {
        // Remove hidden class and add revealing class
        exp.classList.remove("experience-hidden");
        exp.classList.remove("experience-collapsing");
        // Add a staggered delay for each item
        setTimeout(() => {
          exp.classList.add("experience-revealing");
        }, index * 100);
      } else {
        // Add collapsing class
        exp.classList.remove("experience-revealing");
        exp.classList.add("experience-collapsing");
        // After animation completes, add hidden class
        setTimeout(() => {
          exp.classList.add("experience-hidden");
          exp.classList.remove("experience-collapsing");
        }, 500);
      }
    });

    if (viewMoreBtn) {
      viewMoreBtn.textContent = isExpanded ? "View Less" : "View More";
    }
  });
</script>
