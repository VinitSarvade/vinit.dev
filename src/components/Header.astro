---
import { Image } from "astro:assets";

interface Props {
  name: string;
  title: string;
  experience: string;
  headline: string;
  socialLinks: Array<{
    name: string;
    url: string;
    icon: any;
  }>;
}

const { name, title, experience, headline, socialLinks } = Astro.props;
---

<header class="text-center space-y-5">
  {/* Social Links at Top */}
  <nav
    aria-label="Social media links"
    class="flex flex-row justify-center items-center gap-6"
  >
    {
      socialLinks.map((link) => (
        <a
          href={link.url}
          target="_blank"
          rel="noreferrer noopener"
          title={link.name}
          aria-label={link.name}
          class="p-3 rounded-xl bg-white dark:bg-slate-800 hover:bg-emerald-50 dark:hover:bg-emerald-900/20 shadow-sm hover:shadow-md transition-all duration-300 hover:scale-110"
        >
          <Image
            src={link.icon}
            alt={`${link.name} icon`}
            width="22"
            height="22"
            densities={[1, 2, 3]}
          />
        </a>
      ))
    }
  </nav>

  <h1 class="text-4xl sm:text-6xl font-bold tracking-tight bg-gradient-to-r from-emerald-600 via-teal-600 to-cyan-600 dark:from-emerald-400 dark:via-teal-400 dark:to-cyan-400 bg-clip-text text-transparent">
    {name}
  </h1>
  <p class="text-xl sm:text-2xl font-semibold text-gray-800 dark:text-gray-200">
    <span>{title}</span>
    <span class="hidden sm:inline text-emerald-600 dark:text-emerald-400">&nbsp;&middot;&nbsp;</span>
    <span class="block sm:inline">{experience}</span>
  </p>
  <p class="text-base sm:text-lg text-gray-700 dark:text-gray-300 font-medium">
    {headline}
  </p>
</header>
