---
interface Props {
  email: string;
}

const { email } = Astro.props;
---

<section class="space-y-3">
  <h2 class="text-2xl font-semibold">Contact</h2>
  <p class="text-lg font-normal">
    <a
      href={`mailto:${email}`}
      class="hover:underline text-gray-700 dark:text-gray-300"
      rel="noreferrer"
    >
      {email}
    </a>
  </p>
</section>
