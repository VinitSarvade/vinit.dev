---
interface Skill {
  name: string;
  icon: string;
}

interface Props {
  skills: Record<string, Skill[]>;
}

const { skills } = Astro.props;
---

<section class="space-y-5 animate-section">
  <h2
    class="text-3xl font-bold bg-gradient-to-r from-purple-600 to-fuchsia-600 dark:from-purple-400 dark:to-fuchsia-400 bg-clip-text text-transparent"
  >
    Skills
  </h2>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    {
      Object.entries(skills).map(([category, skillList], index) => (
        <div
          class="skill-card bg-white dark:bg-indigo-900/50 backdrop-blur-sm border-2 border-purple-100 dark:border-purple-900/50 rounded-2xl p-6 shadow-md hover:shadow-xl hover:border-purple-300 dark:hover:border-purple-700 hover:scale-[1.02] transition-all duration-300"
          style={`animation-delay: ${index * 0.1}s`}
        >
          <h3 class="text-lg font-bold bg-gradient-to-r from-purple-600 to-fuchsia-600 dark:from-purple-400 dark:to-fuchsia-400 bg-clip-text text-transparent mb-4 pb-2 border-b-2 border-purple-200 dark:border-purple-800/50">
            {category}
          </h3>
          <div class="flex flex-wrap gap-2">
            {skillList.map((skill, skillIndex) => (
              <span
                class="skill-badge inline-flex items-center gap-2 px-3 py-2 text-sm font-semibold text-purple-700 dark:text-purple-200 bg-gradient-to-br from-purple-50 to-fuchsia-50 dark:from-purple-900/30 dark:to-fuchsia-900/30 border border-purple-200 dark:border-purple-800/50 rounded-xl hover:border-purple-400 dark:hover:border-purple-600 hover:shadow-md hover:scale-105 transition-all duration-200"
                style={`animation-delay: ${index * 0.1 + skillIndex * 0.05}s`}
              >
                <img
                  src={`https://cdn.simpleicons.org/${skill.icon}`}
                  alt={`${skill.name} logo`}
                  class="w-4 h-4"
                />
                {skill.name}
              </span>
            ))}
          </div>
        </div>
      ))
    }
  </div>
</section>
