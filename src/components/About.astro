---
interface Props {
  content: string;
}

const { content } = Astro.props;
---

<section class="space-y-4 animate-section">
  <h2 class="text-3xl font-bold bg-gradient-to-r from-emerald-600 to-teal-600 dark:from-emerald-400 dark:to-teal-400 bg-clip-text text-transparent">About</h2>
  <div class="bg-white dark:bg-slate-800/50 backdrop-blur-sm rounded-2xl p-6 shadow-md border border-emerald-100 dark:border-emerald-900/30">
    <p
      class="text-base leading-relaxed font-normal text-gray-800 dark:text-gray-200"
    >
      {content}
    </p>
  </div>
</section>
